{
  "name": "fluxo-backend",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "dev": "node -r ts-node/register/transpile-only src/app.js",
    "start": "npm run migrate && node -r ts-node/register/transpile-only src/app.js",
    "build": "tsc",
    "compile": "tsc --noEmit",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "html-pdf-node": "^1.0.8",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^20.12.0",
    "prisma": "^7.7.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  }
}
