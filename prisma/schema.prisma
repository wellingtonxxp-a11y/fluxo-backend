generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Modelo de Usuário
model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String

  createdAt   DateTime  @default(now())
  lastLogin   DateTime?
  isActive    Boolean   @default(true)

  flows                 Flow[]
  feedbacks             HotspotFeedback[]
  reputation            UserReputation?
  strategies            StrategySession[]
  deliverySessions      DeliverySession[] @relation("UserDeliverySessions")

  @@index([email])
  @@index([createdAt])
}

/// Modelo de Zona Geográfica
model Zone {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  demand     Int               @default(0)
  updatedAt  DateTime          @updatedAt

  flows      Flow[]
  feedbacks  HotspotFeedback[]

  @@index([name])
  @@index([demand])
}

/// Modelo de Flow (Trajeto do usuário)
model Flow {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platform     Platform   @default(ifood)
  zone         String?
  zoneId       Int?
  zoneModel    Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  
  latitude     Float?
  longitude    Float?
  placeName    String?
  placeAddress String?
  
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  durationMin  Float?
  value        Float?
  km           Float?
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([userId])
  @@index([zoneId])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@index([platform])
}

/// Modelo de Feedback de Hotspot
model HotspotFeedback {
  id         Int          @id @default(autoincrement())
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  zoneId     Int
  zone       Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  
  latitude   Float
  longitude  Float
  type       FeedbackType @default(TRAFFIC)
  weight     Float        @default(1)
  
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([zoneId])
  @@index([createdAt])
  @@index([latitude, longitude])
}

/// Modelo de Reputação do Usuário
model UserReputation {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  score         Float    @default(50)
  feedbackCount Int      @default(0)
  
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([score])
}

/// Modelo de Sessão de Estratégia
model StrategySession {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status        StrategyStatus   @default(ACTIVE)
  
  totalDistance Float            @default(0)
  totalTimeMin  Float            @default(0)
  totalScore    Float            @default(0)
  
  startedAt     DateTime         @default(now())
  endedAt       DateTime?
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ============ ENUMS ============

enum Platform {
  ifood
  uber
  noventa_nove
  rappi
}

enum FeedbackType {
  GOOD
  BAD
  DANGER
  TRAFFIC
  HIGH
}

enum StrategyStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============ HOTSPOT SCORING MODELS ============

/// Modelo de Sessão de Entrega (Sinal bruto para scoring)
model DeliverySession {
  id              Int         @id @default(autoincrement())
  userId          Int
  user            User        @relation("UserDeliverySessions", fields: [userId], references: [id], onDelete: Cascade)
  
  // Sinal bruto: origem da entrega
  startLat        Float
  startLng        Float
  
  // Dados adicionais
  endLat          Float?
  endLng          Float?
  durationSec     Int?
  distanceMeters  Float?
  
  // Grid cell mapping
  cellId          String      @db.VarChar(32)
  hotspotCell     HotspotCell @relation(fields: [cellId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime    @default(now())
  
  @@index([userId])
  @@index([cellId])
  @@index([createdAt])
  @@index([startLat, startLng])
}

/// Modelo de Célula de Hotspot (Agregação por célula)
model HotspotCell {
  id                  String      @id @db.VarChar(32)  // geohash
  
  // Localização da célula
  centerLat           Float
  centerLng           Float
  precision           Int         @default(7)  // geohash precision
  
  // Contadores
  pickupCount         Int         @default(0)
  lastUpdated         DateTime    @updatedAt
  
  // Distribuição temporal (JSON para flexibilidade)
  hourlyDistribution  Json        @default("{}")  // Map<hour, count>
  dailyDistribution   Json        @default("{}")  // Map<day, count>
  
  // Metadados
  confidence          Float       @default(0)  // 0-1 based on pickupCount
  
  deliverySessions    DeliverySession[]
  
  createdAt           DateTime    @default(now())
  
  @@index([centerLat, centerLng])
  @@index([pickupCount])
  @@index([lastUpdated])
}