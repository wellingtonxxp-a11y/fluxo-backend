generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("postgresql://postgres:gtAqpfABYWORSiOlqChARWBsTTHnbuCD@junction.proxy.rlwy.net:46257/railway")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String    @db.VarChar(255)

  createdAt   DateTime  @default(now())
  lastLogin   DateTime?
  isActive    Boolean   @default(true)

  flows       Flow[]

  @@index([email])
}

model Flow {
  id          Int       @id @default(autoincrement())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    Platform
  zone        Zone

  startedAt   DateTime
  finishedAt  DateTime?

  durationMinutes Float?
  value       Float?
  km          Float?

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([zone])
  @@index([createdAt])
  @@index([userId, createdAt])
}

enum Platform {
  ifood
  uber
  noventa_nove
  rappi
}

enum Zone {
  zona_sul
  zona_norte
  zona_leste
  zona_oeste
  centro
}