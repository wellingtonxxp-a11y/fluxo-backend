generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique
  password    String

  createdAt   DateTime  @default(now())
  lastLogin   DateTime?
  isActive    Boolean   @default(true)

  flows       Flow[]

  @@index([email])
}

model Flow {
  id          Int       @id @default(autoincrement())

  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform    Platform
  zone        Zone

  // 🔥 LOCALIZAÇÃO (ESSENCIAL)
  latitude    Float?
  longitude   Float?

  // 🔥 FUTURO (PLACES)
  placeName   String?
  placeAddress String?

  startedAt   DateTime
  finishedAt  DateTime?

  durationMin Float?
  value       Float?
  km          Float?

  createdAt   DateTime  @default(now())

  // 🔥 INDEXES IMPORTANTES (performance real)
  @@index([userId])
  @@index([zone])
  @@index([createdAt])
  @@index([latitude, longitude])
}

enum Platform {
  ifood
  uber
  noventa_nove
  rappi
}

enum Zone {
  zona_sul
  zona_norte
  zona_leste
  zona_oeste
  centro
}